      "pack": "sect_storm",
      "title": "灵田失窃",
      "text": "宗门药园一夜之间少了几株百年灵草，脚印直通外门杂役房。管事请你拿个主意：严查到底，还是内部消化？",
      "gates": {
        "requireSect": true,
        "minRank": "outer"
      },
      "actions": [
        {
          "id": "investigate",
          "label": "严查到底",
          "outcome": {
            "kind": "combat",
            "bossId": "shan_xiao",
            "win": {
              "text": "窃贼竟是受雇的山魈所化。你斩妖追赃，灵草尽数归还。",
              "contribution": 50,
              "repRight": 10,
              "stones": 80
            },
            "lose": {
              "text": "山魈遁入深林，你只抢回半筐灵草。",
              "hpPct": 0.15,
              "contribution": 15,
              "stones": 30
            }
          }
        },
        {
          "id": "cover",
          "label": "压下风声",
          "outcome": {
            "kind": "settle",
            "text": "你按下不报，药园补种了事。管事塞来一小袋灵石作封口。",
            "stones": 120,
            "contribution": -10,
            "repRight": -5
          }
        }
      ]
    },
