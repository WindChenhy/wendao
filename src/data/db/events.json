{
  "events": [
    {
      "id": "sect_defend",
      "type": "sect",
      "pack": "sect_storm",
      "title": "魔修叩山",
      "text": "夜半钟声急响，山门外魔气翻涌。数名魔修结阵叩关，口称「借贵宗灵脉一用」。执事传讯：愿出战者重赏，愿破财者亦可。",
      "gates": {
        "requireSect": true,
        "minRank": "steward",
        "minRealm": "golden_core"
      },
      "actions": [
        {
          "id": "defend",
          "label": "出战守山",
          "outcome": {
            "kind": "combat",
            "bossId": "boss_demon_lord",
            "win": {
              "text": "你剑锋所指，魔修溃散。山门大阵重新亮起，宗门记你守山之功。",
              "contribution": 80,
              "repRight": 20,
              "exp": 320
            },
            "lose": {
              "text": "魔修势大，你负伤退回内门。幸有长老及时出手。",
              "hpPct": 0.35,
              "stones": -40,
              "contribution": 5
            }
          }
        },
        {
          "id": "bribe",
          "label": "破财消灾",
          "cost": {
            "stones": 500
          },
          "outcome": {
            "kind": "settle",
            "text": "你奉上灵石，魔修讥笑数声，收阵而去。同门颇有微词。",
            "contribution": -15,
            "repDemonic": 5
          }
        }
      ]
    },
    {
      "id": "sect_exam_storm",
      "type": "sect",
      "pack": "sect_storm",
      "title": "大比风波",
      "text": "宗门大比在即，有人暗中兜售「助威丹」，说是能压过同门一头。你撞见交易，对方笑道：「都是同门，何必较真？」",
      "gates": {
        "requireSect": true,
        "minRank": "outer"
      },
      "actions": [
        {
          "id": "report",
          "label": "禀报执法堂",
          "outcome": {
            "kind": "settle",
            "text": "执法堂连夜彻查，风气一肃。长老对你的正直颇为赏识。",
            "contribution": 35,
            "repRight": 12
          }
        },
        {
          "id": "ignore",
          "label": "当作没看见",
          "outcome": {
            "kind": "settle",
            "text": "你压低斗笠走开。大比场外，多了一笔无人追问的买卖。",
            "repDemonic": 3
          }
        },
        {
          "id": "expose",
          "label": "当场喝破",
          "outcome": {
            "kind": "settle",
            "text": "你当众揭穿，对方恼羞成怒却不敢动手。众人侧目，名声在外。",
            "contribution": 20,
            "repRight": 8,
            "stones": -20
          }
        }
      ]
    },
    {
      "id": "sect_traitor",
      "type": "sect",
      "pack": "sect_storm",
      "title": "叛徒疑云",
      "text": "藏经阁守夜弟子失踪，禁制上留下魔功残痕。执事密令你暗查：若真是内鬼，格杀勿论；若是误会，亦不可打草惊蛇。",
      "gates": {
        "requireSect": true,
        "minRank": "inner",
        "minRealm": "foundation"
      },
      "actions": [
        {
          "id": "investigate",
