          "outcome": {
            "kind": "combat",
            "bossId": "demon_guard",
            "win": {
              "text": "你循煞气追至后山，人赃并获。叛徒伏诛，追回残卷三页。",
              "contribution": 70,
              "repRight": 15,
              "itemId": "sect_fragment",
              "exp": 180
            },
            "lose": {
              "text": "对方狡诈，你只毁去半卷密信，人却走脱了。",
              "hpPct": 0.2,
              "contribution": 10
            }
          }
        },
        {
          "id": "wait",
          "label": "请君入瓮",
          "outcome": {
            "kind": "settle",
            "text": "你布下假禁制守株待兔。三日后真凶现身，被你与执法堂联手拿下。",
            "contribution": 55,
            "repRight": 10,
            "itemId": "sect_fragment"
          }
        }
      ]
    },
